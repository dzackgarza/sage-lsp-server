#!/usr/bin/env python3
"""Launch helper for the Sage-aware python-lsp-server plugin."""

from __future__ import annotations

import os
import sys
from pathlib import Path


def _normalize_argv(argv: list[str]) -> list[str]:
    argv = [arg for arg in argv if arg != "--stdio"]
    if (
        "--check-parent-process" not in argv
        and "--tcp" not in argv
        and "--ws" not in argv
    ):
        argv.append("--check-parent-process")
    return argv


ROOT = Path(__file__).resolve().parents[1]
VENVPY = ROOT / ".venv" / "bin" / "python"

argv = _normalize_argv(sys.argv[1:])
assert VENVPY.exists(), f"sage-lsp requires its virtualenv interpreter at {VENVPY}"
os.execv(str(VENVPY), [str(VENVPY), "-m", "pylsp", *argv])
